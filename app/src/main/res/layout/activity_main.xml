<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EFF4F9"
    android:paddingTop="16dp">

    <TextView
        android:id="@+id/tvNotDefaultWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFB300"
        android:text="⚠️ 點擊此處將此應用設為預設桌面"
        android:textColor="#000000"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"
        android:layout_marginBottom="12dp"
        android:layout_marginHorizontal="16dp"
        android:visibility="gone" />

    <!-- Clean Top Header with Subtle SOS Action -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="40sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvDateAndLunar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginEnd="16dp" />

        <!-- Subdued, discreet safety trigger instead of a loud red/orange button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSos"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="🛡️ 安全"
            android:textSize="14sp"
            android:textColor="#757575"
            app:strokeColor="#B0BEC5"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#D1D9E0"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvEmptyContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="請在系統【通訊錄】中\n將家人設定為「星標」 (收藏)\n以顯示在此處"
        android:textSize="18sp"
        android:textColor="#78909C"
        android:visibility="gone" />

    <GridLayout
        android:id="@+id/gridContacts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="2"
        android:paddingHorizontal="8dp"
        android:alignmentMode="alignMargins" />

    <!-- Premium Tab Bar Dock -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#FFFFFF"
        app:cardElevation="16dp"
        app:cardCornerRadius="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:paddingVertical="8dp">

            <LinearLayout
                android:id="@+id/btnContacts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp">
                <TextView android:text="📖" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="通訊錄" android:textSize="14sp" android:textStyle="bold" android:textColor="#1976D2" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp">
                <TextView android:text="📞" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="撥號" android:textSize="14sp" android:textStyle="bold" android:textColor="#1976D2" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCamera"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp">
                <TextView android:text="📷" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="相機" android:textSize="14sp" android:textStyle="bold" android:textColor="#1976D2" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGallery"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp">
                <TextView android:text="🖼️" android:textSize="26sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                <TextView android:text="圖庫" android:textSize="14sp" android:textStyle="bold" android:textColor="#1976D2" android:layout_marginTop="2dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
